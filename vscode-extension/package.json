{
  "name": "vimcoach-vscode",
  "displayName": "VimCoach (for vscode-neovim)",
  "description": "Native VS Code HUD, Status Bar Coach, and Mastery Dashboard companion for vimcoach.nvim + vscode-neovim.",
  "version": "1.0.0",
  "publisher": "vimcoach",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "vim",
    "neovim",
    "vscode-neovim",
    "hardtime",
    "motions",
    "coach"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vimcoach.ping",
    "onCommand:vimcoach.showHint",
    "onCommand:vimcoach.syncStats",
    "onCommand:vimcoach.openDashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vimcoach.openDashboard",
        "title": "VimCoach: Open Mastery Dashboard"
      },
      {
        "command": "vimcoach.cycleMode",
        "title": "VimCoach: Cycle Mode (Coach / Strict / Adaptive)"
      },
      {
        "command": "vimcoach.resetStats",
        "title": "VimCoach: Reset Stats"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vimcoach-sidebar",
          "title": "VimCoach",
          "icon": "$(mortar-board)"
        }
      ]
    },
    "views": {
      "vimcoach-sidebar": [
        {
          "type": "webview",
          "id": "vimcoach.dashboardView",
          "name": "Mastery Dashboard"
        }
      ]
    },
    "configuration": {
      "title": "VimCoach",
      "properties": {
        "vimcoach.notificationStyle": {
          "type": "string",
          "enum": [
            "both",
            "toast",
            "statusBar"
          ],
          "default": "both",
          "description": "How VimCoach displays coaching hints inside VS Code."
        },
        "vimcoach.statusBarDurationMs": {
          "type": "number",
          "default": 6500,
          "minimum": 1500,
          "maximum": 30000,
          "description": "How long a hint stays highlighted in the VS Code status bar before returning to the fluency score."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
